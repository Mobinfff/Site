# Application Configuration
APP_PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=fitclub_db

# JWT Configuration
JWT_SECRET=your-very-strong-secret-key # Change this in production!
JWT_ACCESS_TOKEN_EXPIRATION_TIME=1h # e.g., 15m, 1h, 1d
JWT_REFRESH_TOKEN_EXPIRATION_TIME=7d # e.g., 7d, 30d

# SMS Service (Example - Faraz SMS)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_NUMBER=your_sms_sender_number
SMS_OTP_PATTERN_CODE=your_otp_pattern_code # If using pattern-based SMS

# Cloudinary (Example for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payment Gateway (Example - ZarinPal)
ZARINPAL_MERCHANT_ID=your_zarinpal_merchant_id
ZARINPAL_CALLBACK_URL=http://localhost:3000/payment/callback # Frontend callback URL

# Default Admin User (Optional - for seeding)
# ADMIN_PHONE=09123456789
# ADMIN_PASSWORD=StrongAdminPassword123!
# ADMIN_EMAIL=admin@fitclub.com
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=User
